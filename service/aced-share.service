# The share service behind Aced's "Copy link" (server.js), as a systemd service.
#
#   sudo cp -r service /opt/aced-share
#   sudo cp /opt/aced-share/aced-share.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now aced-share
#
# It listens on 127.0.0.1:8790; put it behind HTTPS (a reverse proxy or a tunnel). Files are
# kept in /var/lib/aced-share and deleted after 30 days.
[Unit]
Description=Aced share service (locked exams for links)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/env node /opt/aced-share/server.js
Environment=NODE_ENV=production
Environment=BIND=127.0.0.1
Environment=PORT=8790
Environment=DATA_DIR=/var/lib/aced-share
# Behind a tunnel or proxy on this machine that names the visitor in a header it sets itself
# (Cloudflare's tunnel: cf-connecting-ip), so the limits count per visitor. The header counts
# only on connections from TRUSTED_PROXIES; never use a header the visitor can write.
#Environment=CLIENT_IP_HEADER=cf-connecting-ip
#Environment=TRUSTED_PROXIES=127.0.0.1,::1
DynamicUser=yes
StateDirectory=aced-share
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=512M

[Install]
WantedBy=multi-user.target
