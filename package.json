{
  "name": "aced",
  "productName": "Aced",
  "version": "0.6.1",
  "description": "Know exactly what to do before your exam: one list from your own book, with the book beside it",
  "main": "main.js",
  "author": "Korel Uyar",
  "license": "MIT",
  "homepage": "https://github.com/KorelUyar/aced",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KorelUyar/aced.git"
  },
  "bugs": {
    "url": "https://github.com/KorelUyar/aced/issues"
  },
  "scripts": {
    "start": "electron .",
    "sample": "electron . --sample",
    "test": "node scripts/suites.js test",
    "smoke": "node scripts/suites.js smoke",
    "checks": "electron scripts/checks.js",
    "shots": "electron scripts/shots.js docs/shots light && electron scripts/shots.js docs/shots dark && electron scripts/shots-share.js docs/shots light && electron scripts/shots-share.js docs/shots dark && electron scripts/shots-share.js docs/shots light friend && electron scripts/shots-share.js docs/shots dark friend && electron scripts/shots-learn.js docs/shots light && electron scripts/shots-learn.js docs/shots dark && electron scripts/sheet.js docs/shots",
    "icon": "electron scripts/icon.js",
    "vendor": "node scripts/vendor.js",
    "dist": "scripts/build-ocr.sh && electron-builder --mac && node scripts/sign-and-zip.js",
    "ocr": "scripts/build-ocr.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.2.5",
    "electron": "45.4.1",
    "electron-builder": "26.15.3",
    "htm": "3.1.1",
    "katex": "^0.19.1"
  },
  "build": {
    "appId": "com.koreluyar.aced",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "ui/**/*",
      "package.json",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/{build,web,image_decoders,types,cmaps,standard_fonts,iccs,wasm}/**",
      "!node_modules/pdfjs-dist/legacy/{web,image_decoders}/**",
      "!node_modules/pdfjs-dist/legacy/build/*.min.mjs",
      "!node_modules/pdfjs-dist/legacy/build/pdf.{sandbox,renderer}.mjs",
      "!node_modules/@anthropic-ai/sdk/src/**",
      "!node_modules/**/*.{map,d.ts,d.mts,d.cts}"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.education",
      "extendInfo": {
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.koreluyar.aced.exam",
            "UTTypeDescription": "Aced exam",
            "UTTypeConformsTo": ["public.data", "public.content"],
            "UTTypeTagSpecification": { "public.filename-extension": ["aced"] }
          }
        ]
      },
      "icon": "build/icon.icns",
      "identity": null,
      "artifactName": "${productName}-macOS.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "aced",
        "name": "Aced exam",
        "description": "An exam shared from Aced",
        "role": "Editor",
        "rank": "Owner"
      }
    ],
    "protocols": [
      {
        "name": "Aced link",
        "schemes": ["aced"],
        "role": "Viewer"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "extraResources": [
      {
        "from": "build/bin/aced-ocr",
        "to": "aced-ocr"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "LICENSE.electron.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      }
    ]
  }
}
