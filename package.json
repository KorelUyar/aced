{
  "name": "spurt",
  "productName": "Spurt",
  "version": "0.1.0",
  "description": "A study app for the Mac: what to learn, in what order, for the grade you want in the time you have",
  "main": "main.js",
  "author": "Korel Uyar",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "sample": "electron . --sample",
    "smoke": "electron scripts/smoke.js && electron scripts/smoke.js sample",
    "shots": "electron scripts/shots.js docs/shots light && electron scripts/shots.js docs/shots dark && electron scripts/sheet.js docs/shots",
    "icon": "electron scripts/icon.js",
    "vendor": "node scripts/vendor.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.2.5",
    "electron": "45.2.1",
    "electron-builder": "26.15.3",
    "htm": "3.1.1"
  },
  "build": {
    "appId": "com.koreluyar.spurt",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "ui/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": null
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  }
}
